<launch>
    <!-- ================================================================
         FAST-LIO (Livox Mid-360) -> EGO-Planner integration
         (thesis Ch.4/5: indoor navigation with LiDAR-inertial odometry)

         FAST-LIO publishes:
           /Odometry          nav_msgs/Odometry   (frame: camera_init)
           /cloud_registered  sensor_msgs/PointCloud2 (world/camera_init frame)
         grid_map consumes both through its independent cloud+odom
         subscribers; the depth-camera pipeline is disabled by remapping
         depth/pose to dead topics.

         Usage:
           roslaunch ego_planner run_with_fastlio.launch                 (bag replay / bench test)
           roslaunch ego_planner run_with_fastlio.launch use_mavros:=true realworld_experiment:=true   (real flight)
         Set a goal in rviz with "2D Nav Goal" (flight_type 1).
         ================================================================ -->

    <arg name="drone_id" value="0"/>

    <!-- indoor test field (thesis: ~5x5 m room); map is centered on the
         take-off point, effective ceiling = map_size_z + ground_height -->
    <arg name="map_size_x" default="12.0"/>
    <arg name="map_size_y" default="12.0"/>
    <arg name="map_size_z" default="2.0"/>

    <arg name="odom_topic"  default="/Odometry"/>
    <arg name="cloud_topic" default="/cloud_registered"/>

    <arg name="use_mavros" default="false"/>
    <arg name="realworld_experiment" default="false"/>
    <arg name="rviz" default="true"/>

    <!-- FAST-LIO odometry (Mid-360) -->
    <include file="$(find fast_lio)/launch/mapping_mid360.launch">
        <arg name="rviz" value="false"/>
    </include>

    <!-- FAST-LIO's world frame is 'camera_init' (the initial IMU pose);
         tie it to the planner's fixed frame 'world' -->
    <node pkg="tf" type="static_transform_publisher" name="world_to_camera_init"
          args="0 0 0 0 0 0 world camera_init 100"/>

    <!-- planner core -->
    <include file="$(find ego_planner)/launch/advanced_param_exp.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="0"/>
        <!-- LiDAR cloud path: depth camera disabled via dead topics -->
        <arg name="camera_pose_topic" value="nouse1"/>
        <arg name="depth_topic" value="nouse2"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="pose_type" value="1"/>
        <arg name="realworld_experiment" value="$(arg realworld_experiment)"/>
        <!-- camera intrinsics unused in the cloud path -->
        <arg name="cx" value="0.0"/>
        <arg name="cy" value="0.0"/>
        <arg name="fx" value="0.0"/>
        <arg name="fy" value="0.0"/>
        <!-- thesis: ~2 m/s indoor flight -->
        <arg name="max_vel" value="2.0"/>
        <arg name="max_acc" value="3.0"/>
        <arg name="planning_horizon" value="5.0"/>
        <arg name="use_distinctive_trajs" value="false"/>
        <!-- 1: select goals with rviz 2D Nav Goal -->
        <arg name="flight_type" value="1"/>
        <arg name="point_num" value="1"/>
        <arg name="point0_x" value="2.0"/>
        <arg name="point0_y" value="0.0"/>
        <arg name="point0_z" value="1.0"/>
        <arg name="point1_x" value="0.0"/>
        <arg name="point1_y" value="0.0"/>
        <arg name="point1_z" value="1.0"/>
        <arg name="point2_x" value="0.0"/>
        <arg name="point2_y" value="0.0"/>
        <arg name="point2_z" value="1.0"/>
        <arg name="point3_x" value="0.0"/>
        <arg name="point3_y" value="0.0"/>
        <arg name="point3_z" value="1.0"/>
        <arg name="point4_x" value="0.0"/>
        <arg name="point4_y" value="0.0"/>
        <arg name="point4_z" value="1.0"/>
    </include>

    <!-- trajectory server: bspline -> quadrotor_msgs/PositionCommand -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <!-- FAST-LIO /Odometry -> mavros/vision_pose/pose for PX4 EKF2
         (real flight only). PX4 >= 1.14: EKF2_EV_CTRL=11, EKF2_HGT_REF=3;
         PX4 1.13: EKF2_AID_MASK=24, EKF2_HGT_MODE=3. -->
    <node pkg="lidar_to_mavros" type="lidar_to_mavros_node" name="lidar_to_mavros"
          output="screen" if="$(arg use_mavros)"/>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find ego_planner)/launch/default.rviz"/>
    </group>
</launch>
